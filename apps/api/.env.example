APP_NAME="Education Information System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Personal access tokens expire after this many minutes (7 days by default).
SANCTUM_TOKEN_EXPIRATION=10080

ENFORCE_TWO_FACTOR=false
TWO_FACTOR_ISSUER=EduCourt
TWO_FACTOR_CHALLENGE_TTL=300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eis
DB_USERNAME=eis
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Production checklist:
#   APP_ENV=production
#   APP_DEBUG=false
#   ENFORCE_TWO_FACTOR=true
#   UPLOAD_SCANNER=clamav   (recommended: adds a real malware scan on top of structural validation)
#   MAIL_MAILER=smtp        (log only records mail; it never delivers)
#   SESSION_ENCRYPT=true
#   A real PAYMENT_GATEWAY driver (manual is for local testing only)
#   SEED_DEMO_DATA=false    (DemoSeeder refuses to run outside local/testing unless set to true)

# Online payments
PAYMENT_GATEWAY=manual
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=PKR
PAYMENT_MANUAL_CHECKOUT_URL=https://payments.example.test/checkout
REMINDER_GATEWAY=log
REMINDER_CHANNEL=email
# WhatsApp Cloud API (set REMINDER_GATEWAY=whatsapp to deliver WhatsApp reminders).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_TIMEOUT=15
WHATSAPP_DEFAULT_COUNTRY_CODE=92
# Pricing market for rate cards (Meta prices messages per market).
WHATSAPP_MARKET=PK
# Meta app credentials, used by the webhook and `php artisan whatsapp:bootstrap`.
# The app secret signs webhook payloads; the verify token completes the GET handshake.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Upload inspection: strict = structural validation only (default, no ClamAV needed);
# clamav = structural validation plus a ClamAV scan; off = no inspection (local/dev only).
UPLOAD_SCANNER=strict
CLAMAV_BINARY=clamdscan
# Allow PDFs that embed JavaScript or other active content (default false).
UPLOAD_ALLOW_PDF_SCRIPTS=false
SSO_STATE_TTL=600
SSO_HTTP_TIMEOUT=15
