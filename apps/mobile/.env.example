# Default base URL of the Laravel API (/api is optional; it is added if missing).
# This is only a fallback: users can change the server at runtime from the
# "Server" control on the sign-in screen, and that choice is remembered.
# Use your machine LAN IP for a device or emulator, or the public API origin.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
