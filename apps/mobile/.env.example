# API base URL baked into the app at build time.
# Production builds use the dedicated /mobile-api route (proxied straight to
# Laravel) because the app authenticates with a Bearer token, while the web
# app uses the cookie-based BFF under /api.
# A bare host (no path) defaults to <host>/api. Users can still override the
# server from the "Server" control on the sign-in screen.
EXPO_PUBLIC_API_URL=https://educourt.asifent.com/mobile-api
