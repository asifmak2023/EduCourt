# Origin of the Laravel API used by the server-side BFF proxy.
# Requests to /api/* on the web app are forwarded here.
API_ORIGIN=http://127.0.0.1:8000

# Public base path for browser API calls (defaults to the same-origin BFF, /api).
NEXT_PUBLIC_API_BASE=/api

# Direct download link for the native app (APK or store listing).
# When set, a dismissible "Get the app" banner appears for mobile browsers.
# Leave empty to disable the banner.
NEXT_PUBLIC_APP_DOWNLOAD_URL=

# Optional platform-specific links; NEXT_PUBLIC_APP_DOWNLOAD_URL wins if set.
# The Android APK is hosted on this server at /downloads/educourt.apk.
NEXT_PUBLIC_APP_ANDROID_URL=https://educourt.asifent.com/downloads/educourt.apk
NEXT_PUBLIC_APP_IOS_URL=
